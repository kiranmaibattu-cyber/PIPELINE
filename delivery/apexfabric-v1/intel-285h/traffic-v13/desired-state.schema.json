{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apexfabric:sporada-secure:desired-state-with-face:1",
  "title": "Sporada Secure five-application desired state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["edge_id", "revision", "cameras"],
  "properties": {
    "edge_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "cameras": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["camera_id", "source", "solution_pack", "apps", "config"],
        "properties": {
          "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "source": {"type": "string", "pattern": "^file:/run/secrets/apexfabric/[A-Za-z0-9._-]+$"},
          "solution_pack": {"const": "sporada-secure"},
          "fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
          "apps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["anpr", "vehicle_counting", "pedestrian_counting", "fire_smoke_detection", "face_recognition"]}},
          "config": {"$ref": "#/$defs/camera_config"}
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array", "minItems": 2, "maxItems": 2, "items": false,
      "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}]
    },
    "zone": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "poly"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1},
        "poly": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/point"}}
      }
    },
    "camera_config": {
      "type": "object", "additionalProperties": false,
      "required": ["embedding", "emission", "zones"],
      "properties": {
        "embedding": {
          "type": "object", "additionalProperties": false, "required": ["model_id", "dimensions"],
          "properties": {"model_id": {"const": "face-embedding-model-v1"}, "dimensions": {"const": 512}}
        },
        "emission": {
          "type": "object", "additionalProperties": false,
          "required": ["minimum_quality", "cooldown_seconds", "material_change_threshold"],
          "properties": {
            "minimum_quality": {"type": "number", "minimum": 0, "maximum": 1},
            "cooldown_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
            "material_change_threshold": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "zones": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "anpr": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
            "vehicle_counting": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
            "pedestrian_counting": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
            "fire_smoke_detection": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
            "face_recognition": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}}
          }
        }
      }
    }
  }
}
