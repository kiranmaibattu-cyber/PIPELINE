{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sentinel:cv:embedding:4:draft",
  "title": "DRAFT v4 embedding submission",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "embedding_id", "observation_id", "evidence_id", "profile_id", "kind", "model_id", "model_version", "embedding_space", "dim", "distance_metric", "normalization", "vector", "quality", "captured_at"],
  "properties": {
    "schema_version": {"const": "4.0"},
    "embedding_id": {"type": "string", "format": "uuid"},
    "observation_id": {"type": "string", "format": "uuid"},
    "evidence_id": {"type": "string", "format": "uuid"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "kind": {"enum": ["face", "body", "gait", "scene"]},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "embedding_space": {"type": "string", "minLength": 1, "maxLength": 200},
    "dim": {"type": "integer", "minimum": 1},
    "distance_metric": {"const": "cosine"},
    "normalization": {"const": "l2"},
    "vector": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "quality": {"type": "number", "minimum": 0, "maximum": 1},
    "captured_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
