{
  "json_schema_version": "2.2.0",
  "input_preproc": [
    {
      "format": "image",
      "params": {
        "resize": "aspect-ratio",
        "range": [0.0, 1.0],
        "padding": {
          "stride_x": 0,
          "stride_y": 0,
          "fill_value": [114.0, 114.0, 114.0]
        },
        "color_space": "RGB"
      }
    }
  ],
  "output_postproc": [
    {
      "converter": "yolo_v8",
      "labels": ["fire", "smoke"]
    }
  ]
}
