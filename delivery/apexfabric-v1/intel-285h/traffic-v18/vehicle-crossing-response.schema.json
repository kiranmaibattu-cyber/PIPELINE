{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apexfabric:sporada-secure:vehicle-crossing-response:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "status", "artifact_id", "artifact_sha256"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "status": {"enum": ["created", "existing"]},
    "artifact_id": {"type": "string", "pattern": "^artifact-sha256-[0-9a-f]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
