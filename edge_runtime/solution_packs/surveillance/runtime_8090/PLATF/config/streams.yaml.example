# Copy to streams.yaml and fill in real camera credentials.
# streams.yaml is gitignored so credentials never enter history.
# Cameras the app runs on the box (compute-a). Sources are relative to the engine's
# working dir (~/Documents/RE_ID_E). Reference deployment used these same 4 clips.
streams:

  - source: "rtsp://USERNAME:PASSWORD@192.168.1.9:554/video/live?channel=1&subtype=0"
    camera: cam6
    face: true
    gait: true
   
  - source: "rtsp://USERNAME:PASSWORD@192.168.1.7:554/video/live?channel=1&subtype=0"
    camera: cam7
    face: true
    gait: true
