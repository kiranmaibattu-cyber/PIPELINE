{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surveillance Management Command V1",
  "type": "object",
  "required": ["command_id", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "command_id": {"$ref": "#/$defs/id"},
    "type": {"enum": ["gallery.status", "gallery.replace", "enrollment.start", "enrollment.status", "enrollment.stop", "enrollment.save", "enrollment.cancel", "enrollment.retake", "identity.mappings.replace"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "gallery.replace"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/gallery"}}}},
    {"if": {"properties": {"type": {"const": "enrollment.start"}}}, "then": {"properties": {"payload": {
      "type": "object", "required": ["session_id", "person_id", "camera_id"],
      "properties": {"session_id": {"$ref": "#/$defs/id"}, "person_id": {"$ref": "#/$defs/id"}, "camera_id": {"$ref": "#/$defs/id"}}
    }}}},
    {"if": {"properties": {"type": {"enum": ["enrollment.status", "enrollment.stop", "enrollment.save", "enrollment.cancel", "enrollment.retake"]}}}, "then": {"properties": {"payload": {
      "type": "object", "required": ["session_id"], "properties": {"session_id": {"$ref": "#/$defs/id"}}
    }}}},
    {"if": {"properties": {"type": {"const": "identity.mappings.replace"}}}, "then": {"properties": {"payload": {
      "type": "object", "required": ["revision", "mappings"],
      "properties": {"revision": {"type": "integer", "minimum": 1}, "mappings": {
        "type": "array", "maxItems": 10000, "items": {
          "type": "object", "required": ["camera_id", "stream_session_id", "local_identity_id", "central_person_id"],
          "properties": {"camera_id": {"$ref": "#/$defs/id"}, "stream_session_id": {"$ref": "#/$defs/id"},
            "local_identity_id": {"type": ["integer", "string"]}, "central_person_id": {"$ref": "#/$defs/id"}}
        }
      }}
    }}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
    "gallery": {
      "type": "object", "required": ["revision", "embedding_space", "people"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "embedding_space": {"type": "string", "description": "Must equal the value returned by gallery.status; includes model XML/BIN fingerprint and preprocessing contract."},
        "people": {"type": "array", "maxItems": 1000, "items": {
          "type": "object", "required": ["person_id", "display_name", "templates"],
          "properties": {
            "person_id": {"$ref": "#/$defs/id"}, "display_name": {"type": "string"},
            "group": {"enum": ["", "authorised", "unauthorised"]},
            "templates": {"type": "array", "minItems": 1, "maxItems": 20,
              "items": {"type": "array", "minItems": 512, "maxItems": 512, "items": {"type": "number"}}}
          }
        }}
      }
    }
  }
}
