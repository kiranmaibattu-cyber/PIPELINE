{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apexfabric:face-recognition:face-sample:1",
  "title": "Face embedding submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "event_id", "camera_id", "observed_at", "model_id", "dimensions", "embedding", "quality", "face_crop_url"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 200},
    "observed_at": {"type": "string", "format": "date-time"},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "dimensions": {"type": "integer", "minimum": 1, "maximum": 4096},
    "embedding": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "number"}},
    "quality": {"type": "number", "minimum": 0, "maximum": 1},
    "face_crop_url": {"type": "string", "pattern": "^/snapshots/(?!snapshots/)[A-Za-z0-9._/-]+\\.(jpg|jpeg|png)$"}
  }
}
