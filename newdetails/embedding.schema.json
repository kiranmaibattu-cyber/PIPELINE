{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:sentinel:cv:embedding:2","type":"object","additionalProperties":false,
  "required":["schema_version","embedding_id","observation_id","evidence_id","modality","model_id","model_version","embedding_space","dimensions","distance_metric","normalization","vector","quality","captured_at"],
  "properties":{"schema_version":{"const":"2.0"},"embedding_id":{"type":"string","minLength":1,"maxLength":200},"observation_id":{"type":"string","minLength":1,"maxLength":200},"evidence_id":{"type":"string","minLength":1,"maxLength":200},
    "modality":{"enum":["face","body","gait","scene"]},"model_id":{"type":"string","minLength":1,"maxLength":200},"model_version":{"type":"string","minLength":1,"maxLength":100},"embedding_space":{"type":"string","minLength":1,"maxLength":200},
    "dimensions":{"type":"integer","minimum":1,"maximum":4096},"distance_metric":{"const":"cosine"},"normalization":{"const":"l2"},"vector":{"type":"array","minItems":1,"maxItems":4096,"items":{"type":"number"}},"quality":{"type":"number","minimum":0,"maximum":1},"captured_at":{"type":"string","format":"date-time"},"metadata":{"type":"object"}},
  "description":"dimensions and vector length must match the registered embedding_space. Management validates that invariant against its model registry and never compares different spaces."
}
