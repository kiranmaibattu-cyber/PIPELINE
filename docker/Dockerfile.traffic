ARG INTEL_TRAFFIC_RUNTIME_BASE=localhost/apexfabric-intel-traffic-runtime-base:intel-285h-2026.08.24-v1
FROM ${INTEL_TRAFFIC_RUNTIME_BASE}

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/pipeline \
    SOLUTION_PACK=traffic \
    APEXFABRIC_CONTRACT_VERSION=v1 \
    EDGE_AGENT_COMPILE_ONLY=1 \
    APEXFABRIC_SECRETS_ROOT=/run/secrets/apexfabric \
    APEXFABRIC_STATE_ROOT=/state \
    APEX_API_HOST=0.0.0.0 \
    APEX_API_PORT=8080 \
    DESIRED_STATE_RELOAD_INTERVAL=2 \
    DESIRED_STATE_RELOAD_RETRY_INTERVAL=10 \
    DESIRED_STATE_RELOAD_STARTUP_GRACE=3 \
    HOME=/tmp/apexfabric \
    XDG_CACHE_HOME=/tmp/apexfabric/cache

WORKDIR /opt/pipeline

COPY edge_runtime /opt/pipeline/edge_runtime
COPY models/traffic /models/traffic

RUN python -c "from pathlib import Path; from edge_runtime.model_registry.baked import BakedModelValidator; from edge_runtime.model_registry.registry import ModelRegistry; BakedModelValidator(ModelRegistry.from_file(Path('/opt/pipeline/edge_runtime/model_registry/models.yaml')), Path('/models')).validate('traffic')" \
    && test "$(id -u apexruntime)" = "10001"

ARG IMAGE_VERSION=2026.09.10-v2
ARG INTEL_TRAFFIC_RUNTIME_BASE_DIGEST=unresolved

LABEL org.opencontainers.image.source="https://github.com/kiranmaibattu-cyber/PIPELINE" \
      org.opencontainers.image.title="ApexFabric Traffic Edge Runtime" \
      org.opencontainers.image.description="Intel 285H traffic solution-pack runtime" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      io.apexfabric.contract.version="v1" \
      io.apexfabric.hardware.profile="intel-285h" \
      io.apexfabric.image.role="solution-runtime" \
      io.apexfabric.models.delivery="baked-in" \
      io.apexfabric.runtime-base.digest="${INTEL_TRAFFIC_RUNTIME_BASE_DIGEST}"

# ApexFabric V1 compiles /configs/desired_state.json into /plans, keeps
# persistent event/snapshot state under /state, and uses baked models under /models.
EXPOSE 8080

USER 10001:10001
CMD ["python", "-m", "edge_runtime.runtime.solution_image_entrypoint"]
