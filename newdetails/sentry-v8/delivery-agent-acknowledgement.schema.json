{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sentry:cv:delivery-agent-acknowledgement:1.0",
  "title": "Sentry V8 delivery-agent durable acknowledgement",
  "description": "sequences contains exactly the observation, manifest evidence order, then manifest embedding order; no entry may be omitted, added, or reordered.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "package_id", "deployment_id", "sequences"],
  "properties": {
    "status": {"enum": ["durable", "duplicate"]},
    "package_id": {"type": "string", "format": "uuid"},
    "deployment_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,200}$"},
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "object_type", "object_id"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "object_type": {"enum": ["observation", "evidence", "embedding"]},
          "object_id": {"type": "string", "format": "uuid"}
        }
      }
    }
  },
  "x-sentry-relational-constraints": [
    "package_and_deployment_match_request",
    "entries_exactly_match_all_package_objects",
    "order_is_observation_then_evidence_then_embedding",
    "sequence_values_are_contiguous"
  ]
}
