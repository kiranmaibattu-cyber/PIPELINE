{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apexfabric:sporada-secure:desired-state:18",
  "title": "Sporada Secure eight-application desired state",
  "type": "object",
  "additionalProperties": false,
  "required": ["edge_id", "revision", "cameras"],
  "properties": {
    "edge_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "cameras": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["camera_id", "source", "solution_pack", "apps", "config"],
        "properties": {
          "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "source": {"type": "string", "pattern": "^file:/run/secrets/apexfabric/[A-Za-z0-9._-]+\\.url$"},
          "solution_pack": {"const": "sporada-secure"},
          "fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
          "apps": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["anpr", "vehicle_counting", "vehicle_entry_exit_counts", "pedestrian_counting", "fire_smoke_detection", "face_recognition", "scene_embeddings", "person_reid"]}
          },
          "config": {"$ref": "#/$defs/camera_config"}
        },
        "allOf": [{
          "if": {"properties": {"apps": {"contains": {"const": "vehicle_entry_exit_counts"}}}},
          "then": {"properties": {"config": {"required": ["counting_lines"], "properties": {"counting_lines": {"required": ["vehicle_entry_exit_counts"]}}}}}
        }, {
          "if": {"properties": {"apps": {"contains": {"const": "scene_embeddings"}}}},
          "then": {"properties": {"config": {"required": ["scene_embedding", "scene_emission"]}}}
        }, {
          "if": {"properties": {"apps": {"contains": {"const": "person_reid"}}}},
          "then": {"properties": {"config": {"required": ["reid_embedding", "reid_emission", "gait", "reassociation"]}}}
        }]
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array", "minItems": 2, "maxItems": 2, "items": false,
      "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}]
    },
    "zone": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "poly"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1},
        "poly": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/point"}}
      }
    },
    "counting_line": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "a", "b", "direction_mapping"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 200},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "a": {"$ref": "#/$defs/point"},
        "b": {"$ref": "#/$defs/point"},
        "direction_mapping": {
          "type": "object", "additionalProperties": false,
          "description": "Crossing direction relative to the oriented line A to B. Looking from A toward B, the left side is IN and the right side is OUT; reversing A and B swaps the physical sides.",
          "required": ["right_to_left", "left_to_right"],
          "properties": {
            "right_to_left": {"const": "in"},
            "left_to_right": {"const": "out"}
          }
        },
        "minimum_track_age_frames": {"type": "integer", "minimum": 1, "maximum": 300, "default": 3},
        "minimum_crossing_displacement": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.02},
        "crossing_cooldown_seconds": {"type": "number", "minimum": 0, "maximum": 3600, "default": 10}
      }
    },
    "camera_config": {
      "type": "object", "additionalProperties": false,
      "required": ["embedding", "emission", "zones"],
      "properties": {
        "embedding": {
          "type": "object", "additionalProperties": false, "required": ["model_id", "dimensions"],
          "properties": {"model_id": {"const": "face-embedding-model-v1"}, "dimensions": {"const": 512}}
        },
        "emission": {
          "type": "object", "additionalProperties": false,
          "required": ["minimum_quality", "cooldown_seconds", "material_change_threshold"],
          "properties": {
            "minimum_quality": {"type": "number", "minimum": 0, "maximum": 1},
            "preferred_quality": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.65},
            "selection_window_seconds": {"type": "number", "minimum": 0, "maximum": 30, "default": 1.5},
            "cooldown_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
            "material_change_threshold": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "scene_embedding": {
          "type": "object", "additionalProperties": false,
          "required": ["model_id", "model_version", "embedding_space", "dimensions"],
          "properties": {
            "model_id": {"const": "google/siglip2-base-patch16-224"},
            "model_version": {"const": "75de2d55ec2d0b4efc50b3e9ad70dba96a7b2fa2"},
            "embedding_space": {"type": "string", "minLength": 1},
            "dimensions": {"const": 768}
          }
        },
        "scene_emission": {
          "type": "object", "additionalProperties": false,
          "required": ["interval_seconds", "jpeg_quality"],
          "properties": {
            "interval_seconds": {"type": "number", "minimum": 0.25, "maximum": 3600},
            "jpeg_quality": {"type": "integer", "minimum": 50, "maximum": 100}
          }
        },
        "reid_embedding": {
          "type": "object", "additionalProperties": false,
          "required": ["body", "face", "gait"],
          "properties": {
            "body": {"type": "object", "additionalProperties": false, "required": ["model_id", "model_version", "embedding_space", "dimensions"], "properties": {"model_id": {"const": "transreid_ssl_int8"}, "model_version": {"const": "v1"}, "embedding_space": {"const": "transreid_ssl_int8@v1:l2:384"}, "dimensions": {"const": 384}}},
            "face": {"type": "object", "additionalProperties": false, "required": ["model_id", "model_version", "embedding_space", "dimensions"], "properties": {"model_id": {"const": "face-embedding-model-v1"}, "model_version": {"const": "adaface_ir101_int8-v1"}, "embedding_space": {"const": "adaface-ir101-int8@v1:aligned112:l2:512"}, "dimensions": {"const": 512}}},
            "gait": {"type": "object", "additionalProperties": false, "required": ["model_id", "model_version", "embedding_space", "dimensions"], "properties": {"model_id": {"const": "gaitbase_int8"}, "model_version": {"const": "v1"}, "embedding_space": {"const": "gaitbase_int8@v1:30x64x44:parts16x256:l2:4096"}, "dimensions": {"const": 4096}}}
          }
        },
        "reid_emission": {
          "type": "object", "additionalProperties": false,
          "required": ["interval_seconds", "jpeg_quality", "silhouette_interval_frames", "minimum_body_quality"],
          "properties": {
            "interval_seconds": {"type": "number", "minimum": 0.25, "maximum": 3600},
            "jpeg_quality": {"type": "integer", "minimum": 50, "maximum": 100},
            "silhouette_interval_frames": {"type": "integer", "minimum": 1, "maximum": 60},
            "minimum_body_quality": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "gait": {
          "type": "object", "additionalProperties": false,
          "required": ["silhouette_source", "minimum_sequence_frames", "model_sequence_frames", "maximum_buffer_frames", "minimum_motion_pixels"],
          "properties": {
            "silhouette_source": {"const": "background_subtraction"},
            "minimum_sequence_frames": {"type": "integer", "minimum": 10, "maximum": 30},
            "model_sequence_frames": {"const": 30},
            "maximum_buffer_frames": {"type": "integer", "minimum": 30, "maximum": 180}
            ,"minimum_motion_pixels": {"type": "number", "minimum": 0, "maximum": 100}
          }
        },
        "reassociation": {
          "type": "object", "additionalProperties": false,
          "required": ["maximum_gap_seconds", "minimum_body_similarity", "maximum_center_distance_pixels"],
          "properties": {
            "maximum_gap_seconds": {"type": "number", "minimum": 0, "maximum": 60},
            "minimum_body_similarity": {"type": "number", "minimum": 0, "maximum": 1}
            ,"maximum_center_distance_pixels": {"type": "number", "minimum": 0, "maximum": 4096}
          }
        },
        "zones": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "anpr": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
            "vehicle_counting": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
            "pedestrian_counting": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
            "fire_smoke_detection": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
            "face_recognition": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
            "scene_embeddings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
            "person_reid": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}}
          }
        },
        "counting_lines": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "vehicle_entry_exit_counts": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/counting_line"}}
          }
        }
      }
    }
  }
}
