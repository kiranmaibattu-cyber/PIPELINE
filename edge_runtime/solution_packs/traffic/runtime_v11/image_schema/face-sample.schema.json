{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apexfabric:sporada-secure:face-sample:1",
  "title": "Anonymous face sample upload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sample_id", "event_id", "edge_id", "camera_id",
    "stream_session_id", "track_id", "frame_id", "observed_at", "model_id",
    "embedding_space", "dimensions", "embedding", "quality",
    "detector_confidence", "face_bbox", "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sample_id": {"type": "string", "pattern": "^face-[a-f0-9]{32}$"},
    "event_id": {"type": "string", "minLength": 1},
    "edge_id": {"type": "string", "minLength": 1},
    "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "stream_session_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "track_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "integer", "minimum": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "model_id": {"const": "adaface-ir101-int8-v1"},
    "embedding_space": {"const": "adaface-ir101-int8-v1:512:bgr-aligned-112"},
    "dimensions": {"const": 512},
    "embedding": {
      "type": "array", "minItems": 512, "maxItems": 512,
      "items": {"type": "number", "minimum": -1, "maximum": 1}
    },
    "quality": {"type": "number", "minimum": 0, "maximum": 1},
    "detector_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "face_bbox": {"$ref": "#/$defs/bbox"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_frame", "face_crop"],
      "properties": {
        "event_frame": {"$ref": "#/$defs/artifact"},
        "face_crop": {"$ref": "#/$defs/artifact"}
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x1", "y1", "x2", "y2"],
      "properties": {
        "x1": {"type": "integer", "minimum": 0},
        "y1": {"type": "integer", "minimum": 0},
        "x2": {"type": "integer", "minimum": 1},
        "y2": {"type": "integer", "minimum": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_type", "ref"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "content_type": {"const": "image/jpeg"},
        "ref": {"type": "string", "pattern": "^snapshots/(?!snapshots/)[A-Za-z0-9._/-]+\\.jpg$"}
      }
    }
  }
}
