{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apexfabric:sporada-secure:desired-state:1",
  "title": "Sporada Secure desired state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["edge_id", "revision", "cameras"],
  "properties": {
    "edge_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["camera_id", "source", "solution_pack", "apps"],
        "properties": {
          "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "source": {"type": "string", "pattern": "^file:/run/secrets/apexfabric/[A-Za-z0-9._-]+$"},
          "solution_pack": {"const": "sporada-secure"},
          "fps": {"type": "number", "exclusiveMinimum": 0},
          "apps": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["anpr", "vehicle_counting", "pedestrian_counting", "fire_smoke_detection", "face_recognition"]}
          },
          "config": {
            "$ref": "#/$defs/camera_config",
            "description": "Optional application geometry. An enabled app without a zone processes the full frame."
          }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array", "minItems": 2, "maxItems": 2, "items": false,
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ]
    },
    "four_point_zone": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "poly"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "poly": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/point"}}
      }
    },
    "zone_list": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/four_point_zone"}},
    "camera_config": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "zones": {
          "description": "Optional per-application ROIs. Vehicle and pedestrian counting use full-frame occupancy when their ROI is absent.",
          "type": "object", "additionalProperties": false,
          "properties": {
            "vehicle_counting": {"$ref": "#/$defs/zone_list"},
            "pedestrian_counting": {"$ref": "#/$defs/zone_list"},
            "anpr": {"$ref": "#/$defs/zone_list"},
            "fire_smoke_detection": {"$ref": "#/$defs/zone_list"},
            "face_recognition": {"$ref": "#/$defs/zone_list"}
          }
        }
      }
    }
  }
}
